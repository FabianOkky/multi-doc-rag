APP_NAME="Multi-Doc RAG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== Database: PostgreSQL + pgvector via Docker =====
# This app is Postgres+pgvector everywhere (dev, test, prod) — no SQLite.
# The bundled compose.yaml runs a pgvector image locally; just start it:
#   docker compose up -d
# These defaults already match compose.yaml, so no editing is needed for local dev.
# Set DB_PORT=5433 if another Postgres already owns 5432.
# For a hosted DB (prod/demo), point DB_* at any managed Postgres that has pgvector
# (e.g. Neon, Railway) and set DB_SSLMODE=require.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=multi_doc_rag
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SSLMODE=prefer
# Postgres schema for vector search. Dev/prod use "public"; the test env overrides
# this to an isolated schema in .env.testing so tests never touch development data.
DB_SEARCH_PATH=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== Multi-Doc RAG =====
# AI SDK (Gemini). Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# AI models / dimensions (defaults in config/ai.php + config/rag.php).
# gemini-embedding-001 truncated to 768 dims (via outputDimensionality);
# 768 MUST equal the vector() column in the migration.
AI_TEXT_MODEL=gemini-2.5-flash
AI_EMBEDDINGS_MODEL=gemini-embedding-001
AI_EMBEDDINGS_DIMENSIONS=768

# Cache embeddings (provider+model+dims+input) so identical text is not re-sent
# to the API. Pure quota saver; safe to leave on. Embeddings are NEVER failed
# over across models (a different model = different vector space + dimension).
AI_EMBEDDINGS_CACHE=true

# ===== Text provider failover (resilience when the Gemini quota runs out) =====
# TEXT only (chat / summary / suggestions). laravel/ai advances to the next
# provider on a rate limit (429), insufficient credits (402), or overload (503).
# Leave the fallbacks blank to use Gemini only (no behavior change). To add a
# free second tier in production, set a Groq model (https://console.groq.com):
GROQ_API_KEY=
AI_TEXT_FALLBACK_GROQ_MODEL=
# Ollama is only realistic when self-hosted (PaaS free tiers cannot run it):
OLLAMA_URL=http://localhost:11434
AI_TEXT_FALLBACK_OLLAMA_MODEL=

# RAG parameters
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_RETRIEVE_LIMIT=5
RAG_MIN_SIMILARITY=0.4
# Rewrite every question into Indonesian + English before searching, so a question
# in one language finds documents written in the other. Costs one small cached
# prompt per distinct question.
RAG_MULTILINGUAL_QUERY=true
RAG_PARSER_PRIMARY=local

# ===== Production note (Phase 07) =====
# On Railway/Render set APP_ENV=production, APP_DEBUG=false, a fresh APP_KEY,
# a managed Postgres with pgvector (Neon/Railway/etc.) in DB_* (DB_SSLMODE=require),
# GEMINI_API_KEY, and run a separate `php artisan queue:work` worker for parse/embed jobs.
